# Runtime. Copy to .env locally; never commit real values.
NODE_ENV=development
APP_ENV=development
API_PORT=3004
REPOSITORY_MODE=memory

# Server-only. For local MySQL use an SSH tunnel on localhost:13306.
DATABASE_URL=mysql://user:password@127.0.0.1:13306/u_app
CORS_ORIGINS=http://localhost:3000,http://localhost:10086
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
DEV_AUTH_ENABLED=true

# Server-only Casdoor OIDC settings. Leave client credentials blank until issued.
CASDOOR_ISSUER=https://auth.x-lab.top
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ADMIN_MODE=

# Server-only WeChat settings. Never expose the secret to Taro builds.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Public deployment targets; these contain no credentials.
PUBLIC_H5_URL=https://qzu.x-lab.top
PUBLIC_ADMIN_URL=https://qzu-admin.x-lab.top
PUBLIC_API_URL=https://api-u.x-lab.top
