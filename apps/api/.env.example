NODE_ENV=development
APP_ENV=development
API_PORT=3004
REPOSITORY_MODE=memory

# API persistence. Keep real values in apps/api/.env.local only.
DATABASE_URL=mysql://user:password@127.0.0.1:13306/u_app
DEV_AUTH_ENABLED=true
AUTH_SESSION_SECRET=
CORS_ORIGINS=http://localhost:10086,http://localhost:3000

# Casdoor admin authentication (deferred until credentials are issued).
CASDOOR_ISSUER=https://auth.x-lab.top
CASDOOR_ADMIN_MODE=all_authenticated
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=

# WeChat Mini Program authentication (deferred).
WECHAT_APP_ID=
WECHAT_APP_SECRET=
